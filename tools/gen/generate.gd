# Runs every placeholder generator and writes the results into the project:
#   art/sprites/*.png        character + animal sheets, props atlas
#   art/tiles/*.png          terrain atlases (4x4 "match sides" tiles)
#   art/backgrounds/<area>/  sky, far, mid, main, near
#   data/sprites.json        sheet layouts (frame size, rows, fps, loop)
#   data/props.json          props atlas regions
#   data/backgrounds.json    blank signboard rectangles per area
extends RefCounted

const P := preload("res://tools/gen/pix.gd")
const Rig := preload("res://tools/gen/rig.gd")
const Poses := preload("res://tools/gen/poses.gd")
const Chars := preload("res://tools/gen/characters.gd")
const Animals := preload("res://tools/gen/animals.gd")
const Props := preload("res://tools/gen/props.gd")
const Tiles := preload("res://tools/gen/tiles.gd")
const Backgrounds := preload("res://tools/gen/backgrounds.gd")

const COLS := 8
const FPS := {"idle": 6, "run": 12, "jump": 1, "fall": 1, "land": 12, "skid": 10, "throw": 12,
	"hurt": 8, "victory": 10, "slide": 12, "tiphat": 8, "taunt": 8, "stunned": 6, "cuffed": 4,
	"aim": 8, "fumble": 8, "climb": 8, "climb_idle": 1, "walk": 8, "peck": 8, "flap": 10, "tumble": 10}
const NO_LOOP := ["jump", "fall", "land", "throw", "slide", "tiphat", "aim"]
const AREAS := ["town", "farm", "quarry", "lake", "night"]


static func run() -> void:
	var t0 := Time.get_ticks_msec()
	for d in ["res://art/sprites", "res://art/tiles", "res://data"]:
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(d))
	var cast: Dictionary = Chars.all()
	var layouts := {}
	# --- characters
	var human := _layout(Poses.ANIMS, Vector2i(Rig.W, Rig.H))
	for name in cast:
		var sheet := P.img(Rig.W * COLS, Rig.H * Poses.ANIMS.size())
		for row in Poses.ANIMS.size():
			var anim: String = Poses.ANIMS[row][0]
			for i in Poses.ANIMS[row][1]:
				var fr := Rig.render(cast[name], Poses.pose(anim, i, cast[name]))
				P.blit(sheet, fr, Vector2i(i * Rig.W, row * Rig.H))
		_save(sheet, "res://art/sprites/%s.png" % name)
		layouts[name] = human
	# --- animals
	var bird := _layout(Animals.ANIMS, Vector2i(Animals.W, Animals.H))
	for kind in ["hen", "goose", "duck"]:
		var sheet := P.img(Animals.W * COLS, Animals.H * Animals.ANIMS.size())
		for row in Animals.ANIMS.size():
			for i in Animals.ANIMS[row][1]:
				P.blit(sheet, Animals.frame(kind, Animals.ANIMS[row][0], i), Vector2i(i * Animals.W, row * Animals.H))
		_save(sheet, "res://art/sprites/%s.png" % kind)
		layouts[kind] = bird
	_write_json("res://data/sprites.json", {"_comment": "Generated by tools/make_placeholders. One row per animation, frames left to right.", "sheets": layouts})
	# --- props atlas
	_pack_props(Props.all(cast))
	# --- tiles
	for area in AREAS:
		_save(Tiles.atlas(area), "res://art/tiles/%s.png" % area)
	# --- backgrounds
	var bg_meta := {}
	for area in AREAS:
		var dir = "res://art/backgrounds/%s" % area
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir))
		var layers := Backgrounds.theme(area)
		for k in ["sky", "far", "mid", "main", "near"]:
			_save(layers[k], "%s/%s.png" % [dir, k])
		bg_meta[area] = {"signs": layers.signs}
	_write_json("res://data/backgrounds.json", bg_meta)
	print("Placeholder art generated in %d ms" % (Time.get_ticks_msec() - t0))


static func _layout(anims: Array, size: Vector2i) -> Dictionary:
	var rows := []
	for a in anims:
		rows.append({"name": a[0], "frames": a[1], "fps": FPS.get(a[0], 8), "loop": not (a[0] in NO_LOOP)})
	return {"frame": [size.x, size.y], "anims": rows}


## Simple shelf packer: tallest first, rows of fixed width.
static func _pack_props(items: Dictionary) -> void:
	var names := items.keys()
	names.sort_custom(func(a, b): return items[a].get_height() > items[b].get_height())
	var width := 256
	var x := 0
	var y := 0
	var shelf := 0
	var regions := {}
	for n in names:
		var im: Image = items[n]
		if x + im.get_width() > width:
			x = 0
			y += shelf + 1
			shelf = 0
		regions[n] = [x, y, im.get_width(), im.get_height()]
		x += im.get_width() + 1
		shelf = maxi(shelf, im.get_height())
	var atlas := P.img(width, y + shelf + 1)
	for n in names:
		P.blit(atlas, items[n], Vector2i(regions[n][0], regions[n][1]))
	_save(atlas, "res://art/sprites/props.png")
	_write_json("res://data/props.json", regions)


static func _save(im: Image, path: String) -> void:
	var err := im.save_png(ProjectSettings.globalize_path(path))
	if err != OK:
		push_error("Could not write %s" % path)


static func _write_json(path: String, data) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(JSON.stringify(data, "\t"))
